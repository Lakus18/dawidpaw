{% extends 'base.html.twig' %}
{% block title %}Szczegóły prognozy{% endblock %}
{% block body %}
    <h1>Prognoza pogody</h1>
    <table class="table">
        <tbody>
            <tr><th>Lokalizacja</th><td>
                {% if measurement.location %}
                    {{ measurement.location.city }} ({{ measurement.location.country }})
                {% else %}
                    <span class="text-danger">Brak lokalizacji — wybierz ją w edycji.</span>
                {% endif %}
            </td></tr>
            <tr><th>Data</th><td>{{ measurement.date|date('Y-m-d') }}</td></tr>
            <tr><th>Temperatura</th><td>{{ measurement.celsius }} °C</td></tr>
        </tbody>
    </table>
    <a href="{{ path('app_measurement_index') }}">Powrót do listy</a>
    <a class="ms-2" href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">Edytuj</a>
    {{ include('measurement/_delete_form.html.twig') }}
{% endblock %}
