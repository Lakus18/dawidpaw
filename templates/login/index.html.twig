{% extends 'base.html.twig' %}
{% block title %}Logowanie{% endblock %}
{% block body %}
    <h1>Logowanie</h1>
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <form action="{{ path('app_login') }}" method="post">
        <div class="mb-3">
            <label for="username">Login</label>
            <input class="form-control" type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
        </div>
        <div class="mb-3">
            <label for="password">Hasło</label>
            <input class="form-control" type="password" id="password" name="_password" autocomplete="current-password" required>
        </div>
        <button class="btn btn-primary" type="submit">Zaloguj</button>
    </form>
{% endblock %}
